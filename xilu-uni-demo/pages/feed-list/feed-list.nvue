<template>
    <list class="page">
        <!-- 加载按钮置顶 -->
        <cell>
            <button class="btn" @click="reload">重新加载</button>
        </cell>

        <!-- 信息流自渲染（列表）：每 5 条普通数据插 1 条广告，卡片由插件内原生 View 拼出。
             每个广告位独立成败（item.failed），一个没填充不影响其它；未就绪时该 cell 只占 1px + opacity 0。 -->
        <cell v-for="(item, idx) in items" :key="idx">
            <view v-if="item.ad && !item.failed" class="ad-box" :style="adBoxStyle">
                <xilu-native-feed :posId="posId" :sceneId="sceneId" :muted="muted" :count="count"
                    :onlySupportPlatform="onlySupportPlatform"
                    :style="adCompStyle"
                    @onAdReceive="onEvent" @onAdRender="onRender" @onAdExpose="onEvent"
                    @onAdClick="onEvent" @onAdClose="onAdClose"
                    @onAdFailed="onAdFailed" @onRenderFailed="onAdFailed"
                    @onVideoStart="onEvent" @onVideoPause="onEvent"
                    @onVideoComplete="onEvent" @onVideoError="onEvent" />
            </view>
            <view v-else-if="item.ad" class="ad-box ad-empty" :style="{ height: AD_EMPTY_H + 'px' }">
                <text class="ad-empty-text">暂无广告</text>
            </view>
            <view v-else class="row">
                <text class="row-text">{{ item.text }}</text>
            </view>
        </cell>
    </list>
</template>

<script>
import { POS, NATIVE, handleAdFailed } from '@/utils/xilu-ad'

// 广告渲染期间组件容器的高度（不可见，只为让渠道正常布局与测量）
const PRE_RENDER_H = 600
// "暂无广告"提示的高度（提示要看得见，所以给固定高度）
const AD_EMPTY_H = 160

export default {
    data() {
        return {
            // 参数全部取自 utils/xilu-ad.js 的 NATIVE
            posId: POS.nativeSelfRender,
            sceneId: NATIVE.SCENE_ID,
            muted: NATIVE.PLAY_WITH_MUTE,
            count: NATIVE.COUNT_LIST,
            onlySupportPlatform: NATIVE.ONLY_SUPPORT_PLATFORM,
            items: [],
            adHeight: 0,
            adReady: false,
            // 广告位序号：回调无法区分是哪个组件触发的，按出现顺序依次消费
            adCursor: 0,
            AD_EMPTY_H
        }
    },
    computed: {
        adBoxStyle() {
            if (!this.adReady) {
                return { width: '750rpx', height: '1px', opacity: 0 }
            }
            return { width: '750rpx', height: this.adHeight + 'px' }
        },
        adCompStyle() {
            return {
                width: '750rpx',
                height: (this.adReady ? this.adHeight : PRE_RENDER_H) + 'px'
            }
        }
    },
    onLoad() {
        this.buildItems()
    },
    methods: {
        buildItems() {
            // 20 条普通数据 + int index = i * 5 插入广告
            const list = []
            for (let i = 1; i <= 20; i++) {
                list.push({ text: '模拟的普通数据 : ' + i })
            }
            list.splice(0, 0, { ad: true, failed: false })
            list.splice(5, 0, { ad: true, failed: false })
            this.items = list
            this.adCursor = 0
        },
        adSlotIndexes() {
            const out = []
            for (let i = 0; i < this.items.length; i++) {
                if (this.items[i].ad) out.push(i)
            }
            return out
        },
        /** 只让下一个待处理的广告位失败，其它广告位不受影响 */
        failNextAdSlot() {
            const slots = this.adSlotIndexes()
            const idx = slots[this.adCursor]
            this.adCursor++
            if (idx !== undefined) {
                this.$set(this.items, idx, Object.assign({}, this.items[idx], { failed: true }))
            }
        },
        /** 关闭同样只收起被关的那一个广告位 */
        closeNextAdSlot() {
            const slots = this.adSlotIndexes()
            const idx = slots[this.adCursor]
            this.adCursor++
            if (idx !== undefined) {
                this.$set(this.items, idx, Object.assign({}, this.items[idx], { failed: true }))
            }
        },
        reload() {
            this.adReady = false
            this.buildItems()
        },
        onRender(e) {
            const d = (e && e.detail) || e || {}
            const h = d.height || 0
            if (h > 0) {
                this.adHeight = h
                this.adReady = true
            }
        },
        onAdClose() {
            this.closeNextAdSlot()
        },
        onAdFailed(e) {
            // 失败提示由 utils/xilu-ad.js 的 AD_TOAST.ERROR 统一控制
            handleAdFailed('feed-list', e)
            this.failNextAdSlot()
        },
        onEvent(e) {
            console.log('native feed list event:', (e && e.type) || '')
        }
    }
}
</script>

<style>
.page {
    padding: 0;
}

.ad-box {
    width: 750rpx;
    background-color: #f5f5f5;
}

.ad-empty {
    justify-content: center;
    align-items: center;
    background-color: #fafafa;
}

.ad-empty-text {
    font-size: 26rpx;
    color: #bbbbbb;
}

.row {
    padding: 30rpx 24rpx;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #eeeeee;
}

.row-text {
    font-size: 28rpx;
    color: #333333;
}

.btn {
    margin: 24rpx;
}
</style>
