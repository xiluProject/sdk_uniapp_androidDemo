# Build outputs
**/build/
**/.gradle/
**/local.properties
**/gradle.properties
*.log
*.apk

# Uniapp build outputs
**/unpackage/
**/.hbuilderx/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Node modules
node_modules/

# Gradle wrapper
gradle/wrapper/gradle-wrapper.jar

# Keystore and signing related
**/keystore/
**/*.keystore
**/*.jks
**/signing*
**/*sign*

# Patched libs
**/patched-libs/

# Distribution
**/dist/

# Lock files
*.lock

# Build aar files (but allow vendor/)
**/build/**/*.aar
**/patched-libs/**/*.aar
**/dist/**/*.aar

# Vendor SDK libs (allow)
!vendor/**/*.aar
!xilu-ad-bridge/libs_uni/**/*.aar
!xilu-uni-demo/nativeplugins/**/*.aar