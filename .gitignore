# Build outputs
**/build/
**/.gradle/
**/local.properties
*.log
*.apk

# Uniapp build outputs
**/unpackage/
**/.hbuilderx/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Node modules
node_modules/

# Gradle wrapper
gradle/wrapper/gradle-wrapper.jar

# Keystore and signing related
**/keystore/
**/*.keystore
**/*.jks
**/signing*
**/*sign*
**/keystore.properties
!**/keystore.properties.example

# Patched libs
**/patched-libs/

# 构建期生成的 so：libweexcore 每轮构建重打，libweexjss 来自 uniapp-v8-release.aar
**/jniLibs/**/libweexcore.so
**/jniLibs/**/libweexjss.so

# Distribution
**/dist/

# Lock files - ignore IDE/OS locks, keep package manager locks
*.lock
!package-lock.json
!yarn.lock
!pnpm-lock.yaml

# SDK 源码工程（独立仓库，放在这里只是为了本地编译，别提交）
/XiluSdk_android_jdk11-master/